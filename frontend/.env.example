# Production: set this to the deployed backend API base URL, including /api/v1.
# Leave empty for same-origin deployments or local Vite proxy development.
VITE_API_URL=

# Optional frontend request timeout in milliseconds.
VITE_API_TIMEOUT_MS=120000

# Local Vite development only.
VITE_DEV_BACKEND_URL=http://localhost:8000
VITE_DEV_PROXY_TIMEOUT_MS=300000
VITE_DEV_PORT=5173
VITE_SOURCEMAP=false

# Vercel deployments should configure VITE_API_URL in the project environment settings.
