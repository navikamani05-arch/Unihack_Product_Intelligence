# Database Configuration
DATABASE_URL=sqlite:///./data/ai_product_intelligence.db

# API Configuration
API_TITLE=AI Product Intelligence & Trust Engine
API_VERSION=0.1.0
API_DESCRIPTION=Industrial product data extraction, normalization, and trust scoring

# Application Settings
DEBUG=False
ENVIRONMENT=development

# OpenAI-compatible LLM Configuration
# Required only when using POST /api/v1/extract/{job_id}
# OPENAI_API_KEY=your_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
LLM_PROVIDER=openai_compatible
# Optional comma-separated category list
# PRODUCT_CATEGORIES=Motor,Pump,Valve,Sensor,Bearing,Compressor,Other
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_BATCH_SIZE=2

# Phase 3B Conflict Policy
# These comma-separated classes are configurable; conflict detection remains advisory.
CONFLICT_CRITICAL_ATTRIBUTES=sku,product id,model number,part number,catalog number,mpn,manufacturer,brand
CONFLICT_HIGH_ATTRIBUTES=voltage,power,pressure,dimensions,material,current,frequency,speed,efficiency,temperature,ip rating,frame size,weight
CONFLICT_MEDIUM_ATTRIBUTES=category,series,mounting type,description
CONFLICT_SOURCE_AUTHORITY=manufacturer_documentation,manufacturer_website,structured_catalog,distributor,unknown

# Phase 4 Evaluation
# The supplied Unilog file contains raw inputs only, so it supports rule-based quality checks.
# Leave this unset until an official expected-output CSV/XLSX is uploaded through the Evaluation API.
EVALUATION_INPUT_DATASET_PATH=data/evaluation/Unihack_SampleDataset-Input.csv
EVALUATION_EXPECTED_DATASET_PATH=
EVALUATION_TITLE_MAX_LENGTH=255
EVALUATION_DESCRIPTION_MAX_LENGTH=4000
EVALUATION_ALLOWED_UOMS=v,kv,a,ma,w,kw,mw,hz,khz,mhz,mm,cm,m,m2,mm2,kg,g,lb,l,n,m/s,rpm,c,f,bar,psi,pa,mpa,ohm,khm,mo,db,dbm,percent,%

# Production/runtime controls
# Comma-separated browser origins; do not use * with credentials in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public frontend URL, used for deployment documentation and optional link generation.
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=26214400
REQUEST_TIMEOUT_SECONDS=120
LOGGING_LEVEL=INFO
# Set false in production if interactive API docs should be disabled.
ENABLE_DOCS=True

# Phase 7 controlled discovery — disabled by default; never place provider secrets in source code.
DISCOVERY_PROVIDER=none
# DISCOVERY_PROVIDER_API_KEY=
DISCOVERY_MAX_QUERIES_PER_PRODUCT=4
DISCOVERY_MAX_RESULTS_PER_QUERY=5
DISCOVERY_MAX_SOURCES_PER_PRODUCT=8
DISCOVERY_MAX_FETCHES_PER_RUN=5
DISCOVERY_FETCH_TIMEOUT_SECONDS=15
DISCOVERY_MAX_RESPONSE_BYTES=2000000
DISCOVERY_MAX_REDIRECTS=3
DISCOVERY_MIN_IDENTITY_SCORE=0.60

# Frontend build/development controls. These are consumed by Vite, not the backend.
# VITE_API_URL=https://api.example.com/api/v1
# VITE_API_TIMEOUT_MS=120000
# VITE_DEV_BACKEND_URL=http://localhost:8000
# VITE_DEV_PROXY_TIMEOUT_MS=300000

